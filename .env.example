# Copy to .env on the HOST. Keep it private (chmod 600); never commit it.
# Compose injects only the explicit per-service allowlist, not this entire file.
TZ=Asia/Taipei
PUID=1000
PGID=1000
DNA_IMAGE=pi-durable-news-agent:local
NODE_IMAGE=node:24-bookworm-slim
GLUETUN_IMAGE=qmcgaw/gluetun:latest

# WireGuard: fill these before deployment. Custom requires endpoint and server key.
# For Surfshark set VPN_SERVICE_PROVIDER=surfshark, choose SERVER_COUNTRIES,
# and use your own provider credentials/address. Do not reuse a peer key casually.
VPN_SERVICE_PROVIDER=custom
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ENDPOINT_IP=
# 0 = provider-selected port (required for Surfshark).
# For custom WireGuard, replace 0 with the port from your peer config.
WIREGUARD_ENDPOINT_PORT=0
WIREGUARD_MTU=1320
SERVER_COUNTRIES=
# Leave empty unless a specific local destination is needed. Never use 0.0.0.0/0.
FIREWALL_OUTBOUND_SUBNETS=

# Two distinct random tokens, at least 32 characters each. See README generator.
DNA_CLIENT_TOKEN=
DNA_CRON_TOKEN=

# Main/research use an app-owned Codex subscription grant (auth-login role).
# No Hermes auth sharing. No OpenRouter fallback; opt in explicitly if desired.
DNA_PROVIDER=codex
OPENROUTER_API_KEY=
JEV_BACKEND=typesafe
TYPESAFE_API_KEY=
# Empty selects a default from the authenticated Codex catalog, not a static list.
DNA_MODEL=
DNA_RESEARCH_MODEL=
DNA_SEARCH_MODE=web
DNA_SWEEP_QUERIES=3
DNA_MAX_SAVED_SOURCES=10

# Optional PAID features: leave these empty for the first experiment.
OPENAI_API_KEY=
FIRECRAWL_API_KEY=
DNA_FIRECRAWL_SWEEP_CREDITS=0
DNA_FIRECRAWL_DAILY_CREDITS=0

# Only the UI is published, and only on host loopback. API has no host mapping.
DNA_UI_HOST_PORT=4851
# Hosts, not URLs. Include :port if the external origin uses a nondefault port.
DNA_HUB_HOSTS=news.example.test

# TWO gates: leave both unchanged until the first manual sweep is approved.
# COMPOSE_PROFILES=scheduler
DNA_AUTOMATION_ENABLED=false

# Actual sweep cron (five fields), used to seed the persisted API schedule.
# Owner example: 06:00 and 18:00 in Asia/Taipei. This is not enabled automation.
# The source/Compose fallback remains 0 */8 * * * when this seed is unset.
# Once saved, UI changes persist across restart and take precedence over seeds.
DNA_SWEEP_CRON="0 6,18 * * *"
# Empty follows TZ. The UI also accepts an explicit IANA timezone.
DNA_SWEEP_TIMEZONE=
