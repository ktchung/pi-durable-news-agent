# Allow only checked-out build inputs. Never fetch or patch a different repository.
**
!package.json
!package-lock.json
!apps/
!apps/**
!shared-app-configuration/
!shared-app-configuration/**
!just/
!just/**
!docker/
!docker/*.mjs
!docker/entrypoint.sh
# Final denials also apply inside the allowed source trees.
**/.git
**/.git/**
**/.env
**/.env.*
**/*.env
**/*.env.*
**/node_modules
**/node_modules/**
**/auth
**/auth/**
**/data
**/data/**
**/logs
**/logs/**
**/gluetun
**/gluetun/**
**/integrations
**/integrations/**
**/state
**/state/**
**/.hermes
**/.hermes/**
**/.pi
**/.pi/**
**/dist
**/dist/**
**/*.log
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/*-token
**/*.token
