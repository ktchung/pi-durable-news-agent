    "@earendil-works/pi-durable": "1.1.0",
    "@mozilla/readability": "0.6.0",
    "cron-parser": "5.10.2",
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "linkedom": "0.18.13"
  },
  "devDependencies": {
    "@types/express": "5.0.6"
  }
