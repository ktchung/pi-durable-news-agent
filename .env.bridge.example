# Optional interpolation settings; copy to private .env.bridge, mode 600.
# Use --env-file .env --env-file .env.bridge (in this order).
# Host paths, not tokens. Files must exist, mode 600, readable by PUID/PGID.
DNA_BRIDGE_READ_TOKEN_FILE=./bridge-secrets/read-token
DNA_BRIDGE_ADMIN_TOKEN_FILE=./bridge-secrets/admin-token
# Existing external Docker network; this package does not create it.
DNA_BRIDGE_NETWORK=shared-services
DNA_BRIDGE_ALIAS=news-control
# Change both values together if you rename the private API alias.
DNA_BRIDGE_PRIVATE_ALIAS=news-private-api
DNA_BRIDGE_UPSTREAM=http://news-private-api:4850
